{
  "Console log": {
    "prefix": "clg",
    "body": [
      "console.log(${1});"
    ],
    "description": "Log to console"
  },
  "Arrow function": {
    "prefix": "afn",
    "body": [
      "const ${1:name} = (${2:params}) => {",
      "  ${3}",
      "};"
    ],
    "description": "Create an arrow function"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for (let ${1:i} = 0; ${1:i} < ${2:array}.length; ${1:i}++) {",
      "  const element = ${2:array}[${1:i}];",
      "  ${3}",
      "}"
    ],
    "description": "For loop"
  }
}
